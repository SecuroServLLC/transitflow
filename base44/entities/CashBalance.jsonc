    "card_total_kr": {
      "type": "number",
      "title": "Card Total (kr)",
      "default": 0
    },
    "last_emptied_at": {
      "type": "string",
      "title": "Last Emptied At"
    },
    "emptied_by": {
      "type": "string",
      "title": "Emptied By"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "machine_id"
  ]
}