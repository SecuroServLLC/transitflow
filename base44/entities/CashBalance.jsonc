  "properties": {
    "machine_id": {
      "type": "string",
      "title": "Machine ID"
    },
    "machine_name": {
      "type": "string",
      "title": "Machine Name"
    },
    "cash_total_kr": {
      "type": "number",
      "title": "Cash Total (kr)",
      "default": 0
