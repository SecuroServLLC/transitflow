{
  "name": "Customer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "password": {
      "type": "string",
      "title": "Password"
    },
    "pin": {
      "type": "string",
      "title": "Login PIN (4 digits)"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "credits": {
      "type": "number",
      "title": "Credits",
      "default": 0
    },
    "credit_cards": {
      "type": "string",
      "title": "Credit Cards (JSON)"
    },
    "vehicles": {
      "type": "string",
      "title": "Vehicles (JSON)"
    },
    "connected_users": {
      "type": "string",
      "title": "Connected Users (JSON)"
    },
    "favorite_ticket_type": {
      "type": "string",
      "enum": [
        "adult",
        "child",
        "senior",
        "student",
        "military"
      ],
      "title": "Favorite Ticket Type",
      "default": "adult"
    },
    "favorite_ticket_category": {
      "type": "string",
      "enum": [
        "single",
        "period"
      ],
      "title": "Favorite Ticket Category",
      "default": "single"
    }
  },
  "required": [
    "name"
  ]
}