{
  "name": "Inspector",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Full Name"
    },
    "badge_id": {
      "type": "string",
      "title": "Badge ID (for login)"
    },
    "pin": {
      "type": "string",
      "title": "PIN (4-6 digits)"
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    }
  },
  "required": [
    "name",
    "badge_id",
    "pin"
  ]
}