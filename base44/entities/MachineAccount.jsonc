{
  "name": "MachineAccount",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Machine Name"
    },
    "machine_type": {
      "type": "string",
      "enum": [
        "bus",
        "tvm",
        "express"
      ],
      "title": "Machine Type",
      "default": "tvm"
    },
    "machine_id": {
      "type": "string",
      "title": "Machine ID (4 or 6 digits)"
    },
    "parent_machine_id": {
      "type": "string",
      "title": "Parent Machine ID (for express, 4-digit base)"
    },
    "express_suffix": {
      "type": "string",
      "title": "Express Suffix (00-99)"
    },
    "location_id": {
      "type": "string",
      "title": "Location ID"
    },
    "location_name": {
      "type": "string",
      "title": "Location Name"
    },
    "terminal": {
      "type": "string",
      "title": "Terminal / Platform"
    },
    "access_pin": {
      "type": "string",
      "title": "Access PIN (12-digit)"
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "force_locked": {
      "type": "boolean",
      "title": "Force Locked by Admin",
      "default": false
    },
    "session_token": {
      "type": "string",
      "title": "Session Token"
    },
    "total_transactions": {
      "type": "number",
      "title": "Total Transactions",
      "default": 0
    },
    "last_emptied": {
      "type": "string",
      "title": "Last Cash Emptied"
    }
  },
  "required": [
    "name",
    "machine_id",
    "machine_type"
  ]
}