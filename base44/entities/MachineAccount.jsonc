{
  "name": "MachineAccount",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "machine_id": {
      "type": "string",
      "title": "Machine ID"
    },
    "access_pin": {
      "type": "string",
      "title": "Access PIN (12-digit)"
    },
    "username": {
      "type": "string",
      "title": "Username (legacy)"
    },
    "password": {
      "type": "string",
      "title": "Password (legacy)"
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "force_locked": {
      "type": "boolean",
      "title": "Force Locked by Admin",
      "default": false
    },
    "session_token": {
      "type": "string",
      "title": "Session Token (active session)"
    },
    "cash_balance": {
      "type": "number",
      "title": "Cash Balance (kr)",
      "default": 0
    },
    "card_balance": {
      "type": "number",
      "title": "Card Collected (kr)",
      "default": 0
    },
    "total_transactions": {
      "type": "number",
      "title": "Total Transactions",
      "default": 0
    },
    "last_emptied": {
      "type": "string",
      "title": "Last Cash Emptied"
    }
  },
  "required": [
    "name",
    "machine_id",
    "access_pin"
  ]
}