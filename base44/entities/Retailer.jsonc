{
  "name": "Retailer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Business Name"
    },
    "contact_name": {
      "type": "string",
      "title": "Contact Person"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "commission_rate": {
      "type": "number",
      "title": "Commission Rate (%)",
      "default": 5
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "name"
  ]
}