{
  "name": "ServiceMessage",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "type": {
      "type": "string",
      "enum": [
        "delay",
        "disruption",
        "cancellation",
        "info"
      ],
      "title": "Type",
      "default": "info"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "default": "medium"
    },
    "routes": {
      "type": "string",
      "title": "Affected Routes (comma-separated)"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "expected_resolution": {
      "type": "string",
      "title": "Expected Resolution"
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "published_at": {
      "type": "string",
      "title": "Published At"
    }
  },
  "required": [
    "title",
    "type",
    "message"
  ]
}