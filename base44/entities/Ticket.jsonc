{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "adult",
        "child",
        "senior",
        "student",
        "military"
      ],
      "title": "Ticket Type"
    },
    "ticket_category": {
      "type": "string",
      "enum": [
        "single",
        "period"
      ],
      "title": "Category",
      "default": "single"
    },
    "credits_paid": {
      "type": "number",
      "title": "Credits Paid"
    },
    "purchase_method": {
      "type": "string",
      "enum": [
        "online",
        "kiosk",
        "cashier",
        "machine"
      ],
      "title": "Purchase Method"
    },
    "status": {
      "type": "string",
      "enum": [
        "unused",
        "used",
        "expired",
        "active"
      ],
      "title": "Status"
    },
    "qr_token": {
      "type": "string",
      "title": "QR Token"
    },
    "short_code": {
      "type": "string",
      "title": "Short Code"
    },
    "purchased_at": {
      "type": "string",
      "title": "Purchased At"
    },
    "used_at": {
      "type": "string",
      "title": "Used At"
    },
    "valid_until": {
      "type": "string",
      "title": "Valid Until"
    },
    "customer_id": {
      "type": "string",
      "title": "Customer ID"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "customer_phone": {
      "type": "string",
      "title": "Customer Phone"
    }
  },
  "required": [
    "type",
    "ticket_category",
    "status",
    "qr_token",
    "short_code"
  ]
}